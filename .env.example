DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://cuberecord:cuberecord@localhost:5432/cuberecord
CORS_ALLOWED_ORIGINS=http://localhost:5173
WCA_LIVE_API_URL=https://live.worldcubeassociation.org/api
WCA_LIVE_WS_URL=wss://live.worldcubeassociation.org/socket/websocket
WCA_WEEKEND_START=2026-08-06
WCA_WEEKEND_END=2026-08-10
WCA_COMPETITION_LOOKBACK_DAYS=7
WCA_API_POLL_INTERVAL_SECONDS=60
WCA_ROUND_DISCOVERY_INTERVAL_SECONDS=900
WCA_SUBSCRIPTION_CATCHUP_MINUTES=60
WCA_RETRY_BASE_SECONDS=1
WCA_RETRY_MAX_SECONDS=60
WCA_RETRY_MAX_ATTEMPTS=5
CUBINGCHINA_BASE_URL=https://cubing.com
CUBINGCHINA_WS_URL=wss://cubing.com/ws
CUBINGCHINA_DISCOVERY_INTERVAL_SECONDS=900
CUBINGCHINA_LOOKBACK_DAYS=1
CUBINGCHINA_LOOKAHEAD_DAYS=7
CUBINGCHINA_COMPLETION_GRACE_HOURS=12
CUBINGCHINA_MAX_CONNECTIONS=10
CUBINGCHINA_RETRY_BASE_SECONDS=1
CUBINGCHINA_RETRY_MAX_SECONDS=60
CUBINGCHINA_KEEPALIVE_SECONDS=55
CUBINGNOW_LOG_LEVEL=INFO
PUSH_NOTIFICATION_PROVIDER=webpush
# Keep disabled until migrations, one persistent VAPID pair, and the notification worker are ready.
PUSH_RECORD_EVENT_SOURCE=disabled
WEB_PUSH_VAPID_PUBLIC_KEY=replace-with-public-application-server-key
WEB_PUSH_VAPID_PRIVATE_KEY=replace-with-base64url-der-private-key
WEB_PUSH_VAPID_SUBJECT=mailto:contact@cubingnow.com
PUSH_WORKER_POLL_INTERVAL_SECONDS=5
PUSH_WORKER_BATCH_SIZE=50
PUSH_WORKER_MAX_ATTEMPTS=5
PUSH_WORKER_RETRY_SCHEDULE_SECONDS=60,300,1800,7200
PUSH_WORKER_CLAIM_TIMEOUT_SECONDS=300
PUSH_WORKER_IDENTIFIER=
WEB_PUSH_TTL_SECONDS=300
WEB_PUSH_REQUEST_TIMEOUT_SECONDS=10
